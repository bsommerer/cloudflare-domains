{
  "name": "Kunde XY",
  "enabled": true,
  "repo": "kunde-xy-org/kunde-xy-website",

  "domains": {
    "enabled": true,
    "workerName": "kunde-xy",
    "disableWorkersDev": true,
    "canonicalDomain": "kunde-xy.de",
    "redirectDomains": ["kunde-xy.com"],
    "redirectWWW": true
  },

  "builds": {
    "enabled": true,
    "buildCommand": "npm run build",
    "previews": true,
    "env": { "NODE_VERSION": "22" }
  },

  "contactForms": {
    "kunde-xy": {
      "recipients": ["kontakt@kunde-xy.de"],
      "fromName": "Kunde XY",
      "turnstile": true
    }
  }
}
